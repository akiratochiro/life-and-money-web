{
  "name": "life-and-money",
  "compatibility_date": "2026-10-23",
  // Só o proxy de /api/*. O resto do site são arquivos estáticos.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Só /api/* executa o script. Os estáticos continuam saindo direto da camada de assets, que
    // não conta no limite de requisições do plano gratuito.
    "run_worker_first": ["/api/*"]
  },
  // Sem Cron Triggers. A lista vazia é explícita para o deploy remover o cron que já esteve aqui
  // (decisão 38, desfeita): sem a chave, o wrangler deixaria o agendamento antigo como estava.
  "triggers": {
    "crons": []
  },
  // Guarda quando o Worker disparou o último deploy de destravamento, para não empilhar deploys
  // (decisão 38). Criado com `npx wrangler kv namespace create WAKE_STATE`.
  "kv_namespaces": [
    {
      "binding": "WAKE_STATE",
      "id": "f62d5eea4f844ff594256722a0bb8459"
    }
  ],
  "vars": {
    // URL da API no Render, sem barra no final. Para o wrangler dev, sobrescreva no .dev.vars.
    "API_ORIGIN": "https://life-and-money-api.onrender.com"
  }
}
